 000000EE			RemoveLines proc
				    LOCAL y:DWORD, x:DWORD, bLineFull:BYTE

 000000F4  C7 45 FC		    mov y, BOARD_HEIGHT - 2 
	   00000014
				    .WHILE y > 0
 000000FD  C6 45 F7 01		        mov bLineFull, 1
 00000101  C7 45 F8		        mov x, 1
	   00000001
				        .WHILE x < BOARD_WIDTH - 1
 0000010A  8B 45 FC		            mov eax, y
 0000010D  6B C0 0C		            imul eax, BOARD_WIDTH
 00000110  03 45 F8		            add eax, x
 00000113  8A 88 00000045 R	            mov cl, byte ptr [Board + eax]
				            .IF cl == 0
 0000011D  C6 45 F7 00		                mov bLineFull, 0
				                .BREAK
				            .ENDIF
 00000123  FF 45 F8		            inc x
				        .ENDW

				        .IF bLineFull == 1
 00000132  83 05 0000002D R	            add nScore, 100
	   64
 00000139  8B 4D FC		            mov ecx, y
