 00000014			CheckCollision proc nPX:DWORD, nPY:DWORD, nPiece:DWORD, nRot:DWORD
				    LOCAL i:DWORD, px:DWORD, py:DWORD
				    
 0000001A  8B 45 10		    mov eax, nPiece
