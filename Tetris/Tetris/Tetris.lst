 0000013E  C7 45 F8		                mov x, 1
	   00000001
				                .WHILE x < BOARD_WIDTH - 1
 00000147  8B C1		                    mov eax, ecx
 00000149  48			                    dec eax
 0000014A  6B C0 0C		                    imul eax, BOARD_WIDTH
 0000014D  03 45 F8		                    add eax, x
 00000150  8A 98 00000045 R	                    mov bl, byte ptr [Board + eax]
 00000156  8B C1		                    mov eax, ecx
