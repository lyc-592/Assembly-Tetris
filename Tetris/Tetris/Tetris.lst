 0000015B  03 45 F8		                    add eax, x
 0000015E  88 98 00000045 R	                    mov byte ptr [Board + eax], bl
 00000164  FF 45 F8		                    inc x
				                .ENDW
 0000016D  49			                dec ecx
				            .ENDW
