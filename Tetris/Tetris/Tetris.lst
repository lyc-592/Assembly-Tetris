 0000002C  C7 45 FC		    mov i, 0
	   00000000
				    .WHILE i < 16
 00000035  8B 45 FC		        mov eax, i
 00000038  8A 0C 02		        mov cl, byte ptr [edx + eax]
				        .IF cl != 0
 0000003F  8B 45 FC		            mov eax, i
 00000042  83 E0 03		            and eax, 3
 00000045  03 45 08		            add eax, nPX
 00000048  89 45 F8		            mov px, eax
 0000004B  8B 45 FC		            mov eax, i
 0000004E  C1 E8 02		            shr eax, 2
 00000051  03 45 0C		            add eax, nPY
 00000054  89 45 F4		            mov py, eax
 00000057  8B 45 F4		            mov eax, py
