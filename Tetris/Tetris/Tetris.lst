 00000205  8B 45 F8		                mov eax, y
 00000208  6B C0 0C		                imul eax, BOARD_WIDTH
 0000020B  03 45 FC		                add eax, x
 0000020E  C6 80 00000045 R	                mov byte ptr [Board + eax], 9 
