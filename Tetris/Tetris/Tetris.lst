 0000005D  03 45 F8		            add eax, px
 00000060  8A 88 00000045 R	            mov cl, byte ptr [Board + eax]
				            .IF cl != 0
 0000006A  B8 00000001		                mov eax, 1
				                ret
				            .ENDIF
				        .ENDIF
 00000073  FF 45 FC		        inc i
				    .ENDW
 0000007C  B8 00000000		    mov eax, 0
				    ret
 00000085			CheckCollision endp

