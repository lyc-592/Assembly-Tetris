				; ==========================================================
				; ProcessInput 关键修复：正确保存和恢复旋转角度
				; ==========================================================
 00000229			ProcessInput proc
				    invoke GetAsyncKeyState, VK_RIGHT
				    .IF eax != 0
 00000234  A1 00000039 R	        mov eax, nPieceX
 00000239  40			        inc eax
				        invoke CheckCollision, eax, nPieceY, nCurrentPiece, nCurrentRot
				        .IF eax == 0
 00000256  FF 05 00000039 R	            inc nPieceX
				        .ENDIF
				    .ENDIF

				    invoke GetAsyncKeyState, VK_LEFT
				    .IF eax != 0
 00000267  A1 00000039 R	        mov eax, nPieceX
 0000026C  48			        dec eax
				        invoke CheckCollision, eax, nPieceY, nCurrentPiece, nCurrentRot
				        .IF eax == 0
 00000289  FF 0D 00000039 R	            dec nPieceX
				        .ENDIF
				    .ENDIF

				    invoke GetAsyncKeyState, VK_DOWN
				    .IF eax != 0
 0000029A  A1 0000003D R	        mov eax, nPieceY
 0000029F  40			        inc eax
				        invoke CheckCollision, nPieceX, eax, nCurrentPiece, nCurrentRot
				        .IF eax == 0
 000002BC  FF 05 0000003D R	            inc nPieceY
				        .ENDIF
				    .ENDIF

				    ; --- 旋转逻辑 (修复版) ---
				    invoke GetAsyncKeyState, VK_UP
 000002C9  A9 00008000		    test eax, 8000h
 000002CE  74 42		    jz KeyUp
				    
 000002D0  83 3D 00000041 R	        cmp bRotateHeld, 1
	   01
 000002D7  74 43		        je DoneRotate

				        ; 1. 计算新角度
 000002D9  A1 00000035 R	        mov eax, nCurrentRot
 000002DE  40			        inc eax
 000002DF  83 E0 03		        and eax, 3
				        
				        ; 2. !!! 关键：将新角度压入堆栈保存 !!!
 000002E2  50			        push eax 
				        
				        ; 3. 调用检测 (EAX作为参数传入)
				        invoke CheckCollision, nPieceX, nPieceY, nCurrentPiece, eax
				        
				        ; 4. !!! 关键：将新角度从堆栈弹出到 EDX (因为 EAX 已经被覆盖了) !!!
 000002FB  5A			        pop edx 
				        
				        ; 5. 如果 EAX (返回值) == 0，则更新角度为 EDX (保存的新角度)
				        .IF eax == 0
 00000300  89 15 00000035 R	             mov nCurrentRot, edx
				        .ENDIF
				        
 00000306  C7 05 00000041 R	        mov bRotateHeld, 1
	   00000001
 00000310  EB 0A		        jmp DoneRotate

 00000312			    KeyUp:
 00000312  C7 05 00000041 R	        mov bRotateHeld, 0
	   00000000
				        
 0000031C			    DoneRotate:
				    
				    invoke GetAsyncKeyState, VK_ESCAPE
				    .IF eax != 0
 00000327  C7 05 00000021 R	        mov bGameRunning, 0
	   00000000
				    .ENDIF
 00000331  C3			    ret
 00000332			ProcessInput endp

